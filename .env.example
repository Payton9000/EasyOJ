# EasyOJ Configuration
# Copy this file to .env and customize as needed

# Flask Configuration
FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production; the placeholder value below is rejected on purpose.
# SECRET_KEY=
EASYOJ_HOST=0.0.0.0
EASYOJ_PORT=5000

# Database
# SQLite at data/database.db is used; there is no override variable.

# Judge Engine
# Leave worker count unset to use one worker per logical CPU.
# MAX_JUDGE_WORKERS=
# JUDGE_WORKER_CAP=
JUDGE_TIMEOUT=30000
JUDGE_QUEUE_MAXSIZE=100
JUDGE_TOTAL_ACTIVE_MAX=100
JUDGE_USER_ACTIVE_MAX=3
JUDGE_HOST_MAX_CPU_PERCENT=100
JUDGE_HOST_MIN_AVAILABLE_MEMORY_MB=1024
JUDGE_HOST_BACKOFF_MS=1000
PRACTICE_RUN_TIMEOUT_MS=5000
PRACTICE_RUN_MAX_CONCURRENCY=1
MAX_TIME_LIMIT_MS=20000
MAX_MEMORY_LIMIT_MB=512
# Request body cap. Leave unset: it is derived from the testcase limits so a
# full-size .in/.out pair can actually be uploaded. A smaller value is raised.
# MAX_CONTENT_LENGTH=
LOGIN_RATE_MAX_ENTRIES=10000
SUBMISSION_RATE_MAX=30
SUBMISSION_RATE_WINDOW_SECONDS=60
SUBMISSION_RATE_MAX_ENTRIES=10000
JUDGE_REQUIRE_SANDBOX=1

# Sandbox (Windows-specific)
SANDBOX_ENABLED=1
SANDBOX_APP_CONTAINER=1
SANDBOX_STRICT_APP_CONTAINER=1
SANDBOX_PROFILE_NAME=EasyOJ.Sandbox
SANDBOX_MAX_PROCESSES=8
SANDBOX_MAX_WORKSPACE_BYTES=67108864
SANDBOX_MAX_WORKSPACE_FILES=1024

# Database backups. The service writes a hot backup (VACUUM INTO) at start-up and
# then once per interval; nothing external needs scheduling.
# BACKUP_ENABLED=1
# BACKUP_KEEP=14
# BACKUP_INTERVAL_SECONDS=86400
